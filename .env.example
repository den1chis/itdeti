DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ANTHROPIC_API_KEY=
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Local development: true -> background jobs are not started
DISABLE_SCHEDULER=false
# Student site token lifetime (minutes)
STUDENT_TOKEN_EXPIRE_MINUTES=120
# Extra CORS origins for the student site, comma separated
CORS_EXTRA_ORIGINS=
# Fernet key for viewing student passwords (teacher/admin). Empty -> viewing is off, everything else works.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STUDENT_PASSWORD_KEY=
