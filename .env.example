DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ANTHROPIC_API_KEY=
# dev locally; production on Render (also the default when unset). NEVER "development" on a real database:
# it runs create_all on start and logs every SQL query
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
# Local development: true -> background jobs are not started
DISABLE_SCHEDULER=false
# Student site token lifetime (minutes)
STUDENT_TOKEN_EXPIRE_MINUTES=120
# Allowed browser origins, comma separated (empty -> built-in default: https://den1chis.github.io and
# http://localhost:5500, http://127.0.0.1:5500, http://localhost:5501, http://127.0.0.1:5501)
CORS_ORIGINS=
# Extra origins added to CORS_ORIGINS, comma separated
CORS_EXTRA_ORIGINS=
# true -> /docs, /redoc, /openapi.json are served. Leave unset in production
ENABLE_DOCS=
# true on Render: client IP for the login rate limits is read from CF-Connecting-IP (Cloudflare),
# else from X-Forwarded-For (N-th from the right, see TRUSTED_PROXY_HOPS)
BEHIND_PROXY=
# Fallback without CF-Connecting-IP: number of trusted proxies that append to X-Forwarded-For (default 1)
TRUSTED_PROXY_HOPS=
# Fernet key for viewing student passwords (teacher/admin). Empty -> viewing is off, everything else works.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STUDENT_PASSWORD_KEY=
